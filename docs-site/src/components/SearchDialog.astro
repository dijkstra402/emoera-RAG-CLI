---
import { getNavGroups, type DocsLocale } from '../data/navigation';

interface Props { locale?: DocsLocale }
const { locale = 'zh' } = Astro.props;
const navGroups = getNavGroups(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (href: string) => `${base}${href === '/' ? '/' : href}`;
const copy = locale === 'zh'
  ? { title: '搜索文档', close: '关闭', placeholder: '输入安装、Token、JSON…', empty: '没有找到相关文档，换个关键词试试。' }
  : { title: 'Search docs', close: 'Close', placeholder: 'Search install, token, JSON…', empty: 'No matching docs. Try another keyword.' };
---

<dialog class="search-dialog" data-search-dialog>
  <form method="dialog" class="search-panel">
    <header>
      <b>{copy.title}</b>
      <button value="cancel" aria-label={copy.close}>{copy.close}</button>
    </header>
    <input type="search" placeholder={copy.placeholder} autocomplete="off" data-search-input />
    <div class="search-results" data-search-results>
      {navGroups.flatMap(group => group.items).map(item => (
        <a href={hrefFor(item.href)} data-search-item={`${item.label} ${item.description} ${item.keywords}`.toLowerCase()}>
          <b>{item.label}</b><span>{item.description}</span>
        </a>
      ))}
      <p class="search-empty" data-search-empty hidden>{copy.empty}</p>
    </div>
  </form>
</dialog>
