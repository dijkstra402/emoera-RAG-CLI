---
import DocsLayout from '../layouts/DocsLayout.astro';
---

<DocsLayout title="命令参考" description="按任务查找命令，并用全局参数控制 Profile、输出、超时和请求追踪。" section="Reference">
  <Fragment slot="toc">
    <a href="#global">全局参数</a>
    <a href="#documents">文档</a>
    <a href="#search">检索</a>
    <a href="#chat">问答与会话</a>
    <a href="#platform">平台能力</a>
  </Fragment>

  <h2 id="global">全局参数</h2>
  <table><thead><tr><th>参数</th><th>用途</th></tr></thead><tbody>
    <tr><td><code>--profile</code></td><td>选择配置环境</td></tr>
    <tr><td><code>--endpoint</code></td><td>临时覆盖服务地址</td></tr>
    <tr><td><code>--output</code></td><td>table、json 或 jsonl</td></tr>
    <tr><td><code>--timeout</code></td><td>请求超时时间</td></tr>
    <tr><td><code>--request-id</code></td><td>幂等与审计追踪标识</td></tr>
    <tr><td><code>--quiet</code></td><td>隐藏非结果信息</td></tr>
    <tr><td><code>--no-color</code></td><td>关闭 ANSI 颜色</td></tr>
    <tr><td><code>--debug</code></td><td>输出诊断信息</td></tr>
  </tbody></table>

  <h2 id="documents">组织与文档</h2>
  <pre><code>emoera org list
emoera doc list
emoera doc upload ./manual.pdf
emoera doc show &lt;file-md5&gt;
emoera doc status &lt;file-md5&gt;</code></pre>

  <h2 id="search">可解释检索</h2>
  <pre><code>emoera search "设备监控架构" \
  --top-k 10 \
  --min-score 0.3 \
  --explain</code></pre>

  <h2 id="chat">问答与会话</h2>
  <pre><code>emoera ask "比较两份方案的差异" \
  --model "Qwen3 8B" \
  --file &lt;file-md5-1&gt; \
  --file &lt;file-md5-2&gt; \
  --suggestions

emoera chat sessions
emoera chat messages &lt;session-uuid&gt;
emoera chat run &lt;request-id&gt;
emoera chat cancel &lt;request-id&gt;</code></pre>

  <h2 id="platform">模型、配额与状态</h2>
  <pre><code>emoera model list
emoera quota show
emoera capabilities
emoera status</code></pre>
</DocsLayout>
