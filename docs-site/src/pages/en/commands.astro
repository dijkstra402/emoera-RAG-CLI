---
import DocsLayout from '../../layouts/DocsLayout.astro';
---
<DocsLayout locale="en" title="Command reference" description="Find commands by task and control profiles, output, timeouts, and request tracing with global flags." section="Reference">
  <Fragment slot="toc"><a href="#global">Global flags</a><a href="#documents">Documents</a><a href="#search">Search</a><a href="#chat">Chat</a><a href="#platform">Platform</a></Fragment>
  <h2 id="global">Global flags</h2><table><thead><tr><th>Flag</th><th>Purpose</th></tr></thead><tbody><tr><td><code>--profile</code></td><td>Select an environment</td></tr><tr><td><code>--endpoint</code></td><td>Temporarily override the service URL</td></tr><tr><td><code>--output</code></td><td>table, json, or jsonl</td></tr><tr><td><code>--timeout</code></td><td>Request timeout</td></tr><tr><td><code>--request-id</code></td><td>Idempotency and audit identifier</td></tr><tr><td><code>--quiet</code></td><td>Hide non-result output</td></tr><tr><td><code>--no-color</code></td><td>Disable ANSI color</td></tr><tr><td><code>--debug</code></td><td>Print diagnostics</td></tr></tbody></table>
  <h2 id="documents">Organizations and documents</h2><pre><code>emoera org list
emoera doc list
emoera doc upload ./manual.pdf
emoera doc show &lt;file-md5&gt;
emoera doc status &lt;file-md5&gt;</code></pre>
  <h2 id="search">Explainable search</h2><pre><code>emoera search "device monitoring architecture" \
  --top-k 10 --min-score 0.3 --explain</code></pre>
  <h2 id="chat">Answers and sessions</h2><pre><code>emoera ask "Compare the two proposals" \
  --model "Qwen3 8B" \
  --file &lt;file-md5-1&gt; --file &lt;file-md5-2&gt; \
  --suggestions

emoera chat sessions
emoera chat messages &lt;session-uuid&gt;
emoera chat run &lt;request-id&gt;
emoera chat cancel &lt;request-id&gt;</code></pre>
  <h2 id="platform">Models, quotas, and status</h2><pre><code>emoera model list
emoera quota show
emoera capabilities
emoera status</code></pre>
</DocsLayout>
