---
import DocsLayout from '../../layouts/DocsLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsHref = (path: string) => `${base}/en/${path}`;
---

<DocsLayout locale="en" title="Bring your knowledge base to the terminal" description="Emoera Agent CLI gives developers and AI agents secure, composable, and auditable access to enterprise knowledge." section="Overview">
  <Fragment slot="toc">
    <a href="#open-source">Open source CLI</a>
    <a href="#why">Why a CLI</a>
    <a href="#capabilities">Capabilities</a>
    <a href="#first-command">First command</a>
  </Fragment>

  <div class="docs-visual-hero" id="open-source">
    <img src={`${base}/images/cli-terminal.svg`} alt="Emoera CLI answering a knowledge-base question in a terminal" width="1200" height="720" />
    <div class="visual-caption">
      <span>OPEN SOURCE / v0.1.1</span>
      <p>One binary brings permission-aware enterprise knowledge into terminals, scripts, CI pipelines, and agents.</p>
      <a href="https://github.com/dijkstra402/emoera-RAG-CLI">View the GitHub repository →</a>
    </div>
  </div>

  <h2 id="why">Why use a CLI</h2>
  <p>The web app is ideal for exploration. The command line is built for workflows. Search documents and ask grounded questions interactively, then reuse the same interface in scripts, CI, and agent runtimes.</p>
  <blockquote>Every token has explicit scopes. Every request is traceable and continues to respect platform quotas and organization permissions.</blockquote>

  <img class="workflow-image" src={`${base}/images/agent-workflow.svg`} alt="Developers and agents accessing the RAG pipeline through Emoera CLI" width="1200" height="480" loading="lazy" />

  <h2 id="capabilities">Core capabilities</h2>
  <div class="feature-ledger">
    <div><b>Streaming answers</b><span>See rewrite, retrieval, reranking, and generation stages.</span></div>
    <div><b>Permission-aware search</b><span>Only returns organizations and documents visible to the token.</span></div>
    <div><b>Structured output</b><span>Table, JSON, and JSONL formats for humans and agents.</span></div>
    <div><b>Secure credentials</b><span>Tokens live in the operating-system credential store by default.</span></div>
    <div><b>Document automation</b><span>Script upload, processing status, and document inspection.</span></div>
    <div><b>Environment profiles</b><span>Keep development, staging, and production isolated.</span></div>
  </div>

  <h2 id="first-command">Your first command</h2>
  <pre><code>emoera config init
emoera auth set-token
emoera ask "Summarize our deployment policy"</code></pre>
  <div class="next-step">
    <div><b>Ready to install?</b><span>Choose a native package for macOS, Linux, or Windows.</span></div>
    <a href={docsHref('install')}>Installation guide</a>
  </div>
</DocsLayout>
