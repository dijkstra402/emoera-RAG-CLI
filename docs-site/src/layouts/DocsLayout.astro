---
import { navGroups } from '../data/navigation';
import SearchDialog from '../components/SearchDialog.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section = '文档' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const hrefFor = (href: string) => `${base}${href === '/' ? '/' : href}`;
const isActive = (href: string) => {
  const target = hrefFor(href).replace(/\/$/, '');
  return currentPath === target || (href === '/' && currentPath === base);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3e8" />
    <title>{title} · Emoera CLI</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={hrefFor('/')} aria-label="Emoera CLI 文档首页">
        <span class="brand-mark">E</span>
        <span><b>Emoera CLI</b><small>Docs for humans and agents</small></span>
      </a>
      <nav class="top-actions" aria-label="全局导航">
        <button class="search-trigger" type="button" data-open-search>搜索 <kbd>⌘ K</kbd></button>
        <a href={`${base}/llms.txt`}>llms.txt</a>
        <a href="https://github.com/dijkstra402/emoera-RAG-CLI">GitHub</a>
      </nav>
    </header>

    <details class="mobile-nav">
      <summary>浏览文档</summary>
      <div>
        {navGroups.flatMap(group => group.items).map(item => (
          <a class:list={{ active: isActive(item.href) }} href={hrefFor(item.href)}>{item.label}</a>
        ))}
      </div>
    </details>

    <div class="docs-shell">
      <aside class="sidebar">
        {navGroups.map(group => (
          <section>
            <h2>{group.label}</h2>
            <nav>
              {group.items.map(item => (
                <a class:list={{ active: isActive(item.href) }} href={hrefFor(item.href)}>
                  <span>{item.label}</span><small>{item.description}</small>
                </a>
              ))}
            </nav>
          </section>
        ))}
        <div class="sidebar-note">
          <span>当前版本</span><b>v0.1.1</b>
          <a href="https://github.com/dijkstra402/emoera-RAG-CLI/releases">查看 Release</a>
        </div>
      </aside>

      <main class="document">
        <header class="doc-header">
          <p>{section}</p>
          <h1>{title}</h1>
          <div>{description}</div>
        </header>
        <article class="prose"><slot /></article>
        <footer class="doc-footer">
          <span>发现错误或内容缺失？</span>
          <a href="https://github.com/dijkstra402/emoera-RAG-CLI/issues/new">提交 Issue</a>
        </footer>
      </main>

      <aside class="toc" aria-label="本页目录">
        <h2>本页内容</h2>
        <slot name="toc" />
      </aside>
    </div>

    <SearchDialog />
    <script src={`${base}/site.js`}></script>
  </body>
</html>
